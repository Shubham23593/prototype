# No credentials are needed for the public FIRMS CSV feeds, OSM, or Earth Search.
# Optional: obtain your own free MAP_KEY at https://firms.modaps.eosdis.nasa.gov/api/map_key/
FIRMS_MAP_KEY=
# Use a real MongoDB instance. Without one, the API explicitly uses a local JSON journal.
MONGODB_URI=
API_PORT=4000
ML_SERVICE_URL=http://127.0.0.1:8000
INTERNAL_API_URL=http://127.0.0.1:4000
POLL_INTERVAL_MINUTES=15
# NASA publishes the regional CSVs hourly; this is near-real-time, not a continuous fire sensor.
DEFAULT_DATA_MODE=archive
# In production set an admin key to protect uploads, training, and review changes.
ADMIN_API_KEY=
# Optional separate backend-to-ML credential; otherwise ADMIN_API_KEY is used.
INTERNAL_SERVICE_KEY=
# Optional, genuine population-count raster (not density), e.g. a downloaded WorldPop GeoTIFF.
WORLDPOP_RASTER_URL=
WORLDPOP_YEAR=

NEXT_TELEMETRY_DISABLED=1
