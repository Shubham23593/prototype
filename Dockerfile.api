FROM node:22-bookworm-slim
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci --no-audit --no-fund
COPY server ./server
COPY lib ./lib
COPY data ./data
COPY docs ./docs
COPY tsconfig.json ./
RUN mkdir -p /app/.runtime /app/data/uploads /app/data/raw && chown -R node:node /app
USER node
ENV API_PORT=4000 NODE_ENV=production
EXPOSE 4000
CMD ["node", "--import", "tsx", "server/src/index.ts"]
